// Despliegue en Cloudflare Workers: compila la app con Vite y publica la
// carpeta dist como recursos estáticos. Las rutas /api/* las atiende el Worker
// (worker/index.ts): cuentas de usuario y proyectos.
//
// Base de datos: Supabase si en Cloudflare existen SUPABASE_URL y
// SUPABASE_SERVICE_KEY (en Settings → Variables and Secrets o en Settings →
// Build → Variables and secrets); si no, D1.
// No escribas nunca la clave de Supabase en este fichero.
// El nombre debe coincidir con el Worker conectado al repositorio en Cloudflare.
{
  "name": "paginamiquel",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "build": {
    // Antes de compilar incluye la configuración de Supabase de la sección Build
    // (solo en Cloudflare; ver scripts/worker-build-config.mjs).
    "command": "node scripts/worker-build-config.mjs && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Base de datos D1 (la que se usa sin Supabase; al pasar a Supabase las cuentas
  // se copian solas al entrar). Sin "database_id": Cloudflare la crea sola.
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  // Conserva las variables añadidas en el panel de Cloudflare al desplegar.
  "keep_vars": true,
  "vars": {
    // Pon "false" cuando ya hayas creado tus cuentas para cerrar el registro.
    "ALLOW_SIGNUP": "true",
    "MAX_USERS": "20"
  }
}
