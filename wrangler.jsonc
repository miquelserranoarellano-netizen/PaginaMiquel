// Despliegue en Cloudflare Workers (recursos estáticos): compila la app con
// Vite y publica la carpeta dist. El nombre debe coincidir con el Worker
// conectado al repositorio en el panel de Cloudflare.
{
  "name": "paginamiquel",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
